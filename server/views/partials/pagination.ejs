<% if (totalPages > 1) { %>
    <div class="flex justify-center items-center space-x-2 mt-8">
        <!-- Previous Button -->
        <% if (page > 1) { %>
            <a href="?page=<%= page - 1 %>#<%= section || '' %>" class="px-3 py-2 bg-primary text-white rounded hover:bg-primary-dark transition-colors">
                <i class="fas fa-chevron-left"></i>
            </a>
        <% }  %>
           
        <!-- Page Numbers -->
        <% 
            const startPage = Math.max(1, page - 2);
            const endPage = Math.min(totalPages, page + 2);
        %>
        
        <% if (startPage > 1) { %>
            <a href="?page=1#<%= section || '' %>" class="px-3 py-2 bg-white border border-gray-300 text-slate-600 rounded hover:bg-gray-50 transition-colors">1</a>
            <% if (startPage > 2) { %>
                <span class="px-2 text-slate-400">...</span>
            <% } %>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
            <% if (i === page) { %>
                <span class="px-3 py-2 bg-primary text-white rounded font-semibold"><%= i %></span>
            <% } else { %>
                <a href="?page=<%= i %>#<%= section || '' %>" class="px-3 py-2 bg-white border border-gray-300 text-slate-600 rounded hover:bg-gray-50 transition-colors"><%= i %></a>
            <% } %>
        <% } %>

        <% if (endPage < totalPages) { %>
            <% if (endPage < totalPages - 1) { %>
                <span class="px-2 text-slate-400">...</span>
            <% } %>
            <a href="?page=<%= totalPages %>#<%= section || '' %>" class="px-3 py-2 bg-white border border-gray-300 text-slate-600 rounded hover:bg-gray-50 transition-colors"><%= totalPages %></a>
        <% } %>

        <!-- Next Button -->
        <% if (page < totalPages) { %>
            <a href="?page=<%= page + 1 %>#<%= section || '' %>" class="px-3 py-2 bg-primary text-white rounded hover:bg-primary-dark transition-colors">
                <i class="fas fa-chevron-right"></i>
            </a>
        <% } %>
            
    </div>
<% } %>